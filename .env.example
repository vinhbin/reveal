# Reveal Environment Configuration Template

# -----------------------------------------------------------------------------
# 1. OPTIONAL: Live Google Gemini Multimodal API Configuration
# (If left empty, Reveal automatically runs in offline heuristic mode)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
REVEAL_MODEL=gemini-2.5-flash

# auto preserves the existing API-key setup. To use ADK + Agent Platform,
# set REVEAL_PROVIDER=agent_platform and supply the project and private bucket.
# Explicit cloud mode never falls back to Developer API or offline findings.
REVEAL_PROVIDER=auto
REVEAL_GCS_BUCKET=
# On Replit, put the entire dedicated service-account JSON in this secret.
# Locally, leave it empty to use Application Default Credentials instead.
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# 2. Database URL (Defaults to local SQLite if omitted)
# -----------------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///backend/reveal.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reveal

# Optional path to provisioned persistent media storage (does not create a cloud volume)
# REVEAL_UPLOAD_DIR=/path/to/persistent/uploads
