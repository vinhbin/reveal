modules = ["python-3.12", "nodejs-20", "web", "nix"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]

[deployment]
deploymentTarget = "cloudrun"
build = [
  "sh",
  "-c",
  "uv sync --locked && npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
]
run = [
  "uv",
  "run",
  "--no-sync",
  "python",
  "-m",
  "uvicorn",
  "backend.production:app",
  "--host",
  "0.0.0.0",
  "--port",
  "5000",
]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8001 & cd frontend && npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3000
